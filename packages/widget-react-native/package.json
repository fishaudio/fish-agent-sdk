{
  "name": "@fishaudio/agent-widget-react-native",
  "version": "1.0.0",
  "description": "Drop-in voice-agent widget for React Native apps: a floating button that opens a call panel with live transcript, text input and consent, for Fish Audio agents.",
  "keywords": [
    "fish-audio",
    "voice",
    "agent",
    "widget",
    "react-native",
    "expo"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fishaudio/fish-agent-sdk-web.git",
    "directory": "packages/widget-react-native"
  },
  "homepage": "https://docs.fish.audio/agents/deploy/react-native",
  "bugs": "https://github.com/fishaudio/fish-agent-sdk-web/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "node ../../scripts/assert-pnpm.mjs",
    "prepublishOnly": "node ../../scripts/assert-built.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fishaudio/agent-client": "workspace:^",
    "@fishaudio/agent-react-native": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.88",
    "react-native-svg": ">=15.0.0"
  },
  "devDependencies": {
    "@fishaudio/agent-widget-shared": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "jsdom": "^26.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.5"
  }
}
