{
  "description": "Session tokens handed to the SDK by the app, and whether each is accepted.",
  "cases": [
    {
      "name": "a current LiveKit token is accepted",
      "token": {
        "transport": "livekit",
        "session_id": "sess-1",
        "max_duration_seconds": 600,
        "livekit_url": "wss://example.livekit.cloud",
        "token": "tok"
      },
      "expiresAtOffsetMs": 120000,
      "expect": { "ok": true }
    },
    {
      "name": "fields this SDK does not know are ignored",
      "token": {
        "transport": "livekit",
        "session_id": "sess-1",
        "max_duration_seconds": 600,
        "livekit_url": "wss://example.livekit.cloud",
        "token": "tok",
        "region": "ap-northeast-1",
        "features": { "video": false }
      },
      "expiresAtOffsetMs": 120000,
      "expect": { "ok": true }
    },
    {
      "name": "a token past its join deadline is rejected",
      "token": {
        "transport": "livekit",
        "session_id": "sess-1",
        "max_duration_seconds": 600,
        "livekit_url": "wss://example.livekit.cloud",
        "token": "tok"
      },
      "expiresAtOffsetMs": -1000,
      "expect": { "error": "session_expired" }
    },
    {
      "name": "a deadline written without fractional seconds is read",
      "token": {
        "transport": "livekit",
        "session_id": "sess-1",
        "expires_at": "2020-01-01T00:00:00Z",
        "max_duration_seconds": 600,
        "livekit_url": "wss://example.livekit.cloud",
        "token": "tok"
      },
      "expect": { "error": "session_expired" }
    },
    {
      "name": "a deadline with fractional seconds and a UTC offset is read",
      "token": {
        "transport": "livekit",
        "session_id": "sess-1",
        "expires_at": "2020-01-01T08:00:00.123+08:00",
        "max_duration_seconds": 600,
        "livekit_url": "wss://example.livekit.cloud",
        "token": "tok"
      },
      "expect": { "error": "session_expired" }
    },
    {
      "name": "a far-future deadline with fractional seconds is accepted",
      "token": {
        "transport": "livekit",
        "session_id": "sess-1",
        "expires_at": "2099-01-01T00:00:00.500Z",
        "max_duration_seconds": 600,
        "livekit_url": "wss://example.livekit.cloud",
        "token": "tok"
      },
      "expect": { "ok": true }
    },
    {
      "name": "a deadline that cannot be parsed does not block the call",
      "token": {
        "transport": "livekit",
        "session_id": "sess-1",
        "expires_at": "not-a-date",
        "max_duration_seconds": 600,
        "livekit_url": "wss://example.livekit.cloud",
        "token": "tok"
      },
      "expect": { "ok": true }
    },
    {
      "name": "a transport this SDK does not know asks for an upgrade",
      "token": {
        "transport": "carrier-pigeon",
        "session_id": "sess-1",
        "max_duration_seconds": 600,
        "loft_url": "coop://roof"
      },
      "expiresAtOffsetMs": 120000,
      "expect": { "error": "unsupported_transport", "messageContains": "please upgrade" }
    },
    {
      "name": "the transport is checked before the deadline",
      "token": {
        "transport": "carrier-pigeon",
        "session_id": "sess-1",
        "max_duration_seconds": 600
      },
      "expiresAtOffsetMs": -1000,
      "expect": { "error": "unsupported_transport", "messageContains": "please upgrade" }
    }
  ]
}
