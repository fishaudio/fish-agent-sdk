# Your backend's token endpoint, as the phone reaches it.
# Android with `adb reverse tcp:3001 tcp:3001`: http://localhost:3001/agent-session
# iOS: use your computer's LAN address, e.g. http://192.168.1.20:3001/agent-session
EXPO_PUBLIC_TOKEN_URL=

# Public agent (keyless): the agent's ID and an origin on its allowlist.
EXPO_PUBLIC_AGENT_ID=
EXPO_PUBLIC_AGENT_ORIGIN=
